# Dependencies
node_modules
node_modules.root-owned.*
.pnpm-store/

# Build outputs
build
dist/
# The Node-side JavaScript of the package is committed: a git dependency is not built on install (packages/svelte-native/scripts/build-node.ts)
!/packages/svelte-native/dist/
dist-ssr
.output
.cache

# Framework specific
.svelte-kit
.svelte-native

# Expo / React Native
.expo
expo-env.d.ts
ios/
android/
# The library's own native modules are source, not generated projects (their build outputs stay ignored below)
!/packages/svelte-native/native/*/android/
!/packages/svelte-native/native/*/ios/
/packages/svelte-native/native/*/android/.cxx/
/packages/svelte-native/native/*/android/.gradle/
# The vendored third-party packages (packages/svelte-native/VENDORING.md) are source too: their android/ and ios/ folders, and nitrogen's generated ones, are what the
# package publishes; a build's output below them stays ignored. So is their JavaScript: an Expo module's compiled files are in `build/` (and its config plugin's in
# `plugin/build/`), react-native-maps' declarations in `dist/`, which the global rules above would take.
!/packages/svelte-native/vendor/**/android/
!/packages/svelte-native/vendor/**/ios/
!/packages/svelte-native/vendor/**/build/
!/packages/svelte-native/vendor/**/dist/
/packages/svelte-native/vendor/**/android/build/
/packages/svelte-native/vendor/**/android/.cxx/
/packages/svelte-native/vendor/**/android/.gradle/
/packages/svelte-native/vendor/**/ios/build/
# quick-crypto's podspec downloads libsodium's source into its own ios/ folder when the app turns sodium on (`sodiumEnabled`): a build input, never part of the copy
/packages/svelte-native/vendor/**/ios/libsodium-stable/
/packages/svelte-native/vendor/**/ios/libsodium.tar.gz
# The generated Android project of the other variant (native-qa build --variant parks it here); anchored: the parity references
# under apps/qa/qa/screenshots are named android-api36-... and are tracked
/apps/qa/android-*/
/apps/qa/android.prebuilding
# Samsung Pay SDK for the smoke app (native module smoke test) (proprietary: never committed)
apps/qa/libs/

# Testing
coverage
/test-results/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example
*.local
.local/

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db
*.pem

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local Expo modules ship their Android and iOS projects (the engine and the iOS modules); only their build output stays ignored.
!apps/qa/modules/*/android/
apps/qa/modules/*/android/build/
apps/qa/modules/*/android/.cxx/
!apps/qa/modules/*/ios/
apps/qa/modules/*/ios/build/
apps/qa/modules/*/ios/Pods/
