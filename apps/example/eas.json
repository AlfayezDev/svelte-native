{
	"cli": {
		"version": ">= 24.14.0",
		"appVersionSource": "remote"
	},
	"build": {
		"base": {
			"node": "25.0.0",
			"pnpm": "12.3.4"
		},
		"development": {
			"extends": "base",
			"distribution": "internal"
		},
		"preview": {
			"extends": "base",
			"distribution": "internal",
			"channel": "preview",
			"env": {
				"UPDATES_CHANNEL": "preview",
				"EXPO_PUBLIC_API_URL": "https://dev.qarnos.com",
				"APP_VARIANT": "production"
			},
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"extends": "base",
			"autoIncrement": true,
			"channel": "production",
			"env": {
				"UPDATES_CHANNEL": "production",
				"EXPO_PUBLIC_API_URL": "https://qarnos.com",
				"APP_VARIANT": "production"
			}
		},
		"preview-store": {
			"extends": "preview",
			"distribution": "store"
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "internal"
			},
			"ios": {
				"ascAppId": "6823075203"
			}
		}
	}
}
