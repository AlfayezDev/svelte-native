{
	"name": "@expo-svelte/example",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Expo Svelte showcase: a tour of the library, one route per feature.",
	"main": ".expo-svelte/entry.ts",
	"scripts": {
		"start": "expo-svelte dev",
		"android": "expo-svelte android",
		"ios": "expo-svelte ios",
		"check-setup": "expo-svelte doctor",
		"lint": "eslint .",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p test",
		"test": "bun test --timeout 300000 test"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"expo-svelte": "workspace:*",
		"@sveltejs/kit": "3.4.0",
		"expo": "~58.0.26",
		"expo-camera": "~58.0.14",
		"expo-constants": "~58.0.16",
		"expo-font": "~58.0.12",
		"expo-system-ui": "~58.0.7",
		"react": "catalog:",
		"react-native": "0.88.1",
		"svelte": "5.59.1",
		"tailwindcss": "4.3.5",
		"vite": "catalog:"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"@types/react": "catalog:",
		"eslint": "10.8.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.67.0",
		"valibot": "catalog:"
	}
}
