{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		// This repository checks the library against its source (the `expo-svelte-source` condition of its exports map), so an edit to `packages/expo-svelte/src` needs no rebuild.
		// An app outside it resolves `types` to the declarations in `dist/types`.
		"customConditions": ["expo-svelte-source"],
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx",
		"types": ["react", "react-native", "node"],
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "app.config.ts"],
	"exclude": ["node_modules", ".expo-svelte"]
}
