{
	"name": "@svelte-native/qa",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-webstorage\" exec vite dev",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.native.json",
		"native": "APP_VARIANT=${APP_VARIANT:-qa} svelte-native dev",
		"native:build": "APP_VARIANT=${APP_VARIANT:-qa} vite build --mode native",
		"android": "APP_VARIANT=${APP_VARIANT:-qa} svelte-native android",
		"ios": "APP_VARIANT=${APP_VARIANT:-qa} svelte-native ios",
		"native-qa": "node qa/native-qa.ts",
		"native-qa:emulator": "node qa/native-qa.ts build --abi x86_64 && node qa/native-qa.ts lab --device localhost:5555 --repeat 10 && node qa/native-qa.ts boot --device localhost:5555 --warm 30 --cold 30 && node qa/native-qa.ts report && node qa/native-qa.ts gates --platform android",
		"native-qa:suites": "node qa/native-qa.ts parity --device localhost:5555 && node qa/native-qa.ts a11y --device localhost:5555 --no-install && node qa/native-qa.ts resilience --device localhost:5555 --no-install && node qa/native-qa.ts report",
		"native-qa:test": "bun test --timeout 120000 qa",
		"native-qa:typecheck": "tsc -p qa",
		"native-qa:smoke": "node qa/native-qa.ts build --abi x86_64 --variant smoke && node qa/native-qa.ts smoke --device localhost:5555 && node qa/native-qa.ts report && node qa/native-qa.ts gates --platform android --smoke"
	},
	"devDependencies": {
		"@config-plugins/react-native-adjust": "^14.0.2",
		"@eslint/js": "^10.0.1",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@types/node": "^26.1.1",
		"@types/react": "catalog:",
		"eslint": "10.8.1",
		"eslint-plugin-svelte": "3.23.0",
		"expo-updates": "~29.0.0",
		"globals": "17.11.0",
		"svelte": "file:../../vendor/svelte-5.56.7-216f258.tgz",
		"svelte-check": "^4.6.0",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "catalog:"
	},
	"dependencies": {
		"@hmscore/react-native-hms-location": "^6.16.0-301",
		"@intercom/intercom-react-native": "10.7.0",
		"@alfayez/svelte-native": "workspace:*",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/netinfo": "12.0.1",
		"@react-native-firebase/analytics": "^24.0.0",
		"@react-native-firebase/app": "^24.0.0",
		"@react-native-firebase/messaging": "^24.0.0",
		"@sentry/react-native": "~7.11.0",
		"@statsig/react-native-bindings": "^3.33.2",
		"expo": "~57.0.27",
		"expo-application": "~57.0.3",
		"expo-asset": "~57.0.20",
		"expo-build-properties": "~57.0.22",
		"expo-check-installed-apps": "^0.2.9",
		"expo-constants": "~57.0.21",
		"expo-crypto": "~57.0.0",
		"expo-device": "~57.0.2",
		"expo-file-system": "~57.0.0",
		"expo-font": "~57.0.4",
		"expo-haptics": "~57.0.3",
		"expo-image-picker": "~57.0.0",
		"expo-keep-awake": "~57.0.2",
		"expo-local-authentication": "~57.0.3",
		"expo-localization": "~57.0.2",
		"expo-location": "~57.0.22",
		"expo-notifications": "~57.0.24",
		"expo-screen-orientation": "~57.0.3",
		"expo-secure-store": "~57.0.4",
		"expo-sharing": "~57.0.24",
		"expo-splash-screen": "~57.0.0",
		"expo-status-bar": "~57.0.1",
		"expo-store-review": "~57.0.3",
		"expo-system-ui": "~57.0.4",
		"expo-tracking-transparency": "~57.0.2",
		"expo-web-browser": "~57.0.3",
		"mixpanel-react-native": "^3.0.9",
		"react": "catalog:",
		"react-native": "0.86.3",
		"react-native-adjust": "^5.5.0",
		"react-native-device-info": "^15.0.2",
		"react-native-get-random-values": "~2.0.0",
		"react-native-launch-arguments": "^4.1.0",
		"react-native-live-direction": "0.1.1",
		"react-native-ssl-public-key-pinning": "^1.2.4",
		"valibot": "catalog:"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"main": ".svelte-native/entry.ts",
	"expo": {
		"autolinking": {
			"exclude": [
				"react-native-screens",
				"react-native-safe-area-context",
				"expo-dev-client",
				"expo-dev-launcher",
				"expo-dev-menu",
				"expo-dev-menu-interface",
				"expo-updates-interface",
				"expo-manifests",
				"expo-json-utils",
				"@expo/log-box",
				"@expo/dom-webview",
				"expo-updates"
			]
		}
	}
}
