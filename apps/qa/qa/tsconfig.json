{
	"compilerOptions": {
		"target": "ES2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"customConditions": ["expo-svelte-source"],
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true
	},
	"include": ["**/*.ts"],
	"exclude": ["out", "runs"]
}
