{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"target": "ES2022",
		"strict": true,
		// The library is checked against its source here (the `expo-svelte-source` condition of its exports map), so an edit to it needs no rebuild.
		"customConditions": ["expo-svelte-source"],
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"exclude": [
		"node_modules",
		"build",
		".svelte-kit",
		".expo-svelte",
		"src/lib/native",
		"src/routes/**/+mobile.svelte",
		"src/routes/**/+layout.mobile.svelte",
		"src/routes/**/+error.mobile.svelte",
		"metro.config.cjs"
	]
}
