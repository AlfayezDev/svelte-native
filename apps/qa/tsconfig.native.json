{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["react", "react-native", "node"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/lib/native/**/*", "src/routes/**/+mobile.svelte", "src/routes/**/+layout.mobile.svelte", "src/routes/**/+error.mobile.svelte", "metro.config.cjs"],
  "exclude": ["node_modules", "build", ".expo-svelte"]
}
