{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!**/*.svg", "!apps/qa", "!apps/docs/**/*.svelte", "!apps/example/**/*.svelte", "!packages/expo-svelte/**/*.svelte", "!packages/expo-svelte/dist", "!packages/expo-svelte/vendor", "!examples/**/*.svelte"]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"preset": "recommended",
				"useExhaustiveDependencies": "warn"
			},
			"a11y": {
				"preset": "none"
			},
			"suspicious": {
				"preset": "recommended",
				"noThenProperty": "off",
				"noImplicitAnyLet": "warn",
				"noAssignInExpressions": "warn",
				"useIterableCallbackReturn": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
