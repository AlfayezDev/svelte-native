{
	"name": "svelte-native-minimal",
	"version": "1.0.0",
	"private": true,
	"description": "The smallest Svelte Native app: a root layout, a home screen and a second screen pushed on top of it.",
	"main": ".svelte-native/entry.ts",
	"scripts": {
