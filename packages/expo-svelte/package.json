    "css-select": "^5.1.0",
    "css-tree": "^1.1.3",
    "esbuild": "0.28.1",
    "events": "3.3.0",
    "hoist-non-react-statics": "^3.3.0",
    "invariant": "^2.2.4",
    "react-native-is-edge-to-edge": "^1.3.1",
    "readable-stream": "4.7.0",
