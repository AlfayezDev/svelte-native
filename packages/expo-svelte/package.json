{
  "name": "expo-svelte",
  "version": "0.4.0-rc.10",
  "type": "module",
  "license": "MIT",
  "homepage": "https://expo-svelte.alfayez.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlfayezDev/svelte-native.git",
    "directory": "packages/expo-svelte"
  },
  "bugs": {
    "url": "https://github.com/AlfayezDev/svelte-native/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "expo-svelte-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "expo-svelte-source": "./src/core.ts",
      "types": "./dist/types/core.d.ts",
      "default": "./src/core.ts"
    },
    "./app": {
      "expo-svelte-source": "./src/app.ts",
      "types": "./dist/types/app.d.ts",
      "default": "./src/app.ts"
    },
    "./renderer": {
      "expo-svelte-source": "./src/renderer.ts",
      "types": "./dist/types/renderer.d.ts",
      "default": "./src/renderer.ts"
    },
    "./elements": {
      "expo-svelte-source": "./src/elements.d.ts",
      "types": "./dist/types/elements.d.ts",
      "default": "./src/elements.d.ts"
    },
    "./foreign": {
      "expo-svelte-source": "./src/foreign.ts",
      "types": "./dist/types/foreign.d.ts",
      "default": "./src/foreign.ts"
    },
    "./platform": {
      "expo-svelte-source": "./src/platform.ts",
      "types": "./dist/types/platform.d.ts",
      "default": "./src/platform.ts"
    },
    "./mmkv": {
      "expo-svelte-source": "./src/mmkv.ts",
      "types": "./dist/types/mmkv.d.ts",
      "default": "./src/mmkv.ts"
    },
    "./metro": {
      "expo-svelte-source": "./src/metro.ts",
      "types": "./dist/types/metro.d.ts",
      "default": "./dist/node/metro.cjs"
    },
    "./transformer": {
      "expo-svelte-source": "./src/transformer.ts",
      "types": "./dist/types/transformer.d.ts",
      "default": "./dist/node/transformer.cjs"
    },
    "./lower": {
      "expo-svelte-source": "./src/lower.ts",
      "types": "./dist/types/lower.d.ts",
      "default": "./dist/node/lower.js"
    },
    "./vite": {
      "expo-svelte-source": "./src/vite.ts",
      "types": "./dist/types/vite.d.ts",
      "default": "./dist/node/vite.js"
