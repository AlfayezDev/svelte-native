    "./router": {
      "expo-svelte-source": "./src/router.svelte.ts",
      "types": "./dist/types/router.svelte-module.d.ts",
      "default": "./src/router.svelte.ts"
    },
    "./routes": {
      "expo-svelte-source": "./src/routes-table.ts",
      "types": "./dist/types/routes-table.d.ts",
      "default": "./dist/node/routes.js"
    },
    "./push": {
      "expo-svelte-source": "./src/push/index.ts",
      "types": "./dist/types/push/index.d.ts",
      "default": "./src/push/index.ts"
    },
    "./updates": {
      "expo-svelte-source": "./src/updates/index.ts",
      "types": "./dist/types/updates/index.d.ts",
      "default": "./src/updates/index.ts"
