      "expo-svelte-source": "./src/remote/index.ts",
      "types": "./dist/types/remote/index.d.ts",
      "default": "./src/remote/index.ts"
    },
    "./push/server": {
      "expo-svelte-source": "./src/push/server.ts",
      "types": "./dist/types/push/server.d.ts",
      "default": "./dist/node/push-server.js"
    },
    "./remote/runtime": "./src/remote/runtime.ts",
    "./remote/globals": "./src/remote/globals.ts",
    "./package.json": "./package.json",
    "./app.plugin": {
      "expo-svelte-source": "./src/expo.ts",
      "types": "./dist/types/expo.d.ts",
      "default": "./app.plugin.js"
    }
  },
  "imports": {
    "#vendor/react-native-mmkv": {
      "types": "./vendor/react-native-mmkv/lib/index.d.ts",
      "default": "./vendor/react-native-mmkv/src/index.ts"
    },
    "#vendor/react-native-nitro-modules": {
      "types": "./vendor/react-native-nitro-modules/lib/typescript/index.d.ts",
      "default": "./vendor/react-native-nitro-modules/src/index.ts"
    },
    "#vendor/react-native-quick-crypto": "./vendor/react-native-quick-crypto/src/index.ts",
    "#vendor/hermes-intl": "./vendor/hermes-intl/src/index.js",
    "#vendor/expo-video/*": {
      "types": "./vendor/expo-video/*.d.ts",
      "default": "./vendor/expo-video/*.js"
    },
    "#vendor/react-native-gesture-handler": {
      "types": "./vendor/react-native-gesture-handler/lib/typescript/index.d.ts",
      "default": "./vendor/react-native-gesture-handler/src/index.ts"
    },
    "#vendor/react-native-gesture-handler/types/*": {
      "types": "./vendor/react-native-gesture-handler/lib/typescript/*.d.ts"
    },
    "#vendor/react-native-reanimated": {
      "types": "./vendor/react-native-reanimated/lib/typescript/index.d.ts",
      "default": "./vendor/react-native-reanimated/src/index.ts"
    },
    "#vendor/react-native-svg": {
      "types": "./vendor/react-native-svg/lib/typescript/index.d.ts",
      "default": "./vendor/react-native-svg/src/index.ts"
    },
    "#vendor/react-native-worklets": {
      "types": "./vendor/react-native-worklets/lib/typescript/index.d.ts",
      "default": "./vendor/react-native-worklets/src/index.ts"
    }
  },
  "bin": {
    "expo-svelte": "./dist/node/cli.js"
  },
  "files": [
    "src",
    "dist/node",
    "dist/types",
    "native",
    "vendor",
    "vendor-patches",
    "patches",
    "expo-module.config.json",
    "app.plugin.js",
    "README.md",
    "REFERENCE.md",
    "CHANGELOG.md",
    "LICENSE",
    "!native/**/test",
    "!native/**/*.md",
    "!native/**/build",
    "!native/**/.cxx",
    "!native/**/.gradle",
    "!native/**/Pods",
    "!vendor/**/android/build",
    "!vendor/**/ios/build",
    "!vendor/**/.cxx",
    "!vendor/**/.gradle",
    "!vendor/**/Pods",
    "!vendor/**/libsodium-stable",
    "!vendor/**/libsodium.tar.gz"
  ],
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test --timeout 60000",
    "lint": "eslint .",
    "build": "node scripts/build-node.ts"
  },
  "dependencies": {
