<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 13 and later ask for it at run time (`requestPermission`); the manifest has to declare it for the question to be asked. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Firebase's own service has the same filter at priority -500, so this one, at the default 0, is the app's receiver of every message. -->
    <service
      android:name="expo.modules.sveltepush.SveltePushMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
