{
  "platforms": ["android", "apple"],
  "android": {
    "projects": [
      {
        "name": "svelte-core",
        "path": "native/svelte-core/android",
        "modules": [
          "expo.modules.svelteengine.SvelteEngineModule",
          "expo.modules.svelteupdates.SvelteUpdatesModule",
          "expo.modules.svelteblur.SvelteBlurModule",
          "expo.modules.sveltecore.SvelteFetchModule",
          "expo.modules.sveltecore.SvelteClipboardModule"
        ]
      }
    ]
  },
  "apple": {
    "podspecPath": ["native/svelte-core/ios/SvelteCore.podspec"],
    "swiftModuleName": ["SvelteCore"],
    "modules": ["SvelteInsetsModule", "SvelteNavigationModule", "SvelteUpdatesModule", "SvelteBlurModule", "SvelteFetchModule", "SvelteClipboardModule"],
    "appDelegateSubscribers": ["SvelteCaptureSubscriber"],
    "reactDelegateHandlers": ["SvelteUpdatesReactDelegateHandler"]
  }
}
