{
  "platforms": ["android", "apple"],
  "android": {
    "projects": [
      {
        "name": "svelte-engine",
        "path": "native/svelte-engine/android",
        "modules": ["expo.modules.svelteengine.SvelteEngineModule"]
      },
      {
        "name": "svelte-updates",
        "path": "native/svelte-updates/android",
        "modules": ["expo.modules.svelteupdates.SvelteUpdatesModule"]
      },
      {
        "name": "svelte-blur",
        "path": "native/svelte-blur/android",
        "modules": ["expo.modules.svelteblur.SvelteBlurModule"]
      }
    ]
  },
  "apple": {
    "podspecPath": [
      "native/svelte-capture-ios/ios/SvelteCapture.podspec",
      "native/svelte-insets-ios/ios/SvelteInsets.podspec",
      "native/svelte-navigation-ios/ios/SvelteNavigation.podspec",
      "native/svelte-screens-ios/native/SvelteScreensIOS.podspec",
      "native/svelte-updates/ios/SvelteUpdates.podspec",
      "native/svelte-blur/ios/SvelteBlur.podspec"
    ],
    "swiftModuleName": ["SvelteCapture", "SvelteInsets", "SvelteNavigation", "SvelteUpdates", "SvelteBlur"],
    "modules": ["SvelteInsetsModule", "SvelteNavigationModule", "SvelteUpdatesModule", "SvelteBlurModule"],
    "appDelegateSubscribers": ["SvelteCaptureSubscriber"],
    "reactDelegateHandlers": ["SvelteUpdatesReactDelegateHandler"]
  }
}
