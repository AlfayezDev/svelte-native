+  /**
+   * Sends one of the view's events through the event dispatcher of the new architecture. The JavaScript module of the old architecture's event emitter was
+   * the path before: in a bridgeless app every call of it is reported as a soft exception ("will stop working with interop disabled"), and a playing state
+   * machine makes them several times a second.
+   */
+  private fun dispatch(name: String, data: WritableMap) {
+    val reactContext = context as ReactContext
+    val dispatcher = UIManagerHelper.getEventDispatcherForReactTag(reactContext, id) ?: return
+    dispatcher.dispatchEvent(RiveViewEvent(UIManagerHelper.getSurfaceId(reactContext), id, name, data))
+  }
+
+  private class RiveViewEvent(surfaceId: Int, viewTag: Int, private val name: String, private val data: WritableMap) : Event<RiveViewEvent>(surfaceId, viewTag) {
+    override fun getEventName(): String = name
+    override fun getEventData(): WritableMap = data
+    // Every play, stop and state change is its own event: none replaces an unread one of the same name.
+    override fun canCoalesce(): Boolean = false
+  }
