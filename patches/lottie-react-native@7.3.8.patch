+// [keepUntilEmitter]; a finish event is dropped, as it was, which also bounds the queue.
+- (void)lottieSendEvent:(LottieEventSend)send keepUntilEmitter:(BOOL)keepUntilEmitter
+{
+    [self lottieOnMain:^{
