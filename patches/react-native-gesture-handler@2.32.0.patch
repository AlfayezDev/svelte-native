 constexpr int NEW_ARCH_NUMBER_OF_ATTACH_RETRIES = 25;
 
+#if defined(RCT_NEW_ARCH_ENABLED) && !TARGET_OS_OSX
+// A view that holds React Native's touch handler is where the root recognizer goes, wherever the view is: a sheet or a modal
+// that an app presents itself holds its own touch handler outside every surface view.
+static BOOL RNGHViewHasSurfaceTouchHandler(RNGHUIView *view)
+{
+  for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
+    if ([recognizer isKindOfClass:[RCTSurfaceTouchHandler class]]) {
+      return YES;
+    }
+  }
+  return NO;
+}
+#endif
