+- (void)registerRootViewGestureRecognizerIfAttachedBelow:(nonnull RNGHUIView *)view
+{
+  // Only a view with a handler attached below it needs the root recognizer; a screen that joins its window with none (every screen of an app
+  // that has no gesture) costs a loop over the handlers there are.
+  for (RNGestureHandler *handler in _registry.handlers.objectEnumerator) {
+    if ([handler.recognizer.view isDescendantOfView:view]) {
+      [self registerViewWithGestureRecognizerAttachedIfNeeded:view];
+      return;
+    }
+  }
+}
